# Modèle de configuration — copier vers .env et remplir (le .env n'est jamais commité).
# Source unique de la configuration : rien de tout ceci n'a de valeur par défaut dans le code.
# Lu par docker compose, par la configuration de run IntelliJ, et par ./mvnw spring-boot:run
# (spring.config.import). Sémantique properties : ni `export`, ni guillemets.

# Jeton PRIM, généré sur https://prim.iledefrance-mobilites.fr
# → Mes jetons d'authentification → onglet API
PRIM_API_KEY=

# PostgreSQL/PostGIS. POSTGRES_URL vise localhost ; le compose de la racine la surcharge
# vers l'hôte `db`.
POSTGRES_DB=mapidf
POSTGRES_USER=mapidf
POSTGRES_PASSWORD=
POSTGRES_URL=jdbc:postgresql://localhost:5432/mapidf
